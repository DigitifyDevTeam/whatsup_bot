{
	admin off
}

:{$OLLAMA_GATEWAY_PORT:11435} {
	@unauthorized not header Authorization "Bearer {$OLLAMA_API_KEY}"
	handle @unauthorized {
		header Content-Type application/json
		respond `{"error":"unauthorized"}` 401
	}

	reverse_proxy {$OLLAMA_UPSTREAM:ollama:11434} {
		flush_interval -1
		transport http {
			dial_timeout 10s
			read_timeout 1h
			write_timeout 1h
		}
	}
}
